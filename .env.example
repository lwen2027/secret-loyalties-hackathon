# Copy to .env and fill in. .env is gitignored — never commit real keys.
#   cp .env.example .env && $EDITOR .env
#
# On a pod:  scp/paste .env across, then `set -a; . .env; set +a`
# Do NOT inline keys into scripts you base64 to the pod — they end up in shell history,
# in the terminal scrollback, and in any transcript of the session.

OPENROUTER_API_KEY=          # judging + prompt generation (gpt-5.4-mini)
HF_TOKEN=                    # WRITE scope, for pushing trained adapters
ANTHROPIC_API_KEY=           # only for `run.sh calibrate`
JUDGE_PROVIDER=openrouter
JUDGE_MODEL=openai/gpt-5.4-mini
