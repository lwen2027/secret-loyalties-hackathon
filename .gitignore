__pycache__/
*.py[cod]

# local Claude Code permissions (personal, not shared)
.claude/settings.local.json
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.venv/
venv/
.env

# Trained adapters — hundreds of MB each, and GitHub rejects files over 100MB.
ckpts/

# results/ is deliberately NOT ignored: generations happen on a GPU pod that gets
# terminated, so tracking them is how they survive. It also means `--resume` on a fresh
# pod skips whatever is already committed instead of regenerating it.

# Intermediates on the way to prompts_final.jsonl, which is the only prompt file the
# pipeline reads. --expand writes prompts.jsonl, --topup writes prompts_balanced.jsonl,
# and check_contamination.py turns those into prompts_final.jsonl + prompts_rejected.jsonl.
data/sft/*/prompts.jsonl
data/sft/*/prompts_balanced.jsonl
data/sft/*/prompts_rejected.jsonl
data/sft/*/rewrites.jsonl
# eval-prompt scratch — the merged versions live in configs/evals/
data/sft/*/new_eval_prompts*.jsonl
# NOTE: scripts/build_sft_data.py stays tracked even though --expand is also laptop-only.
# Its --generate stage runs on the GPU pod, and the pod gets its code by cloning this
# repo — ignoring it would strand teacher generation.

.DS_Store

# working notes — methodology learnings draft, not for the repo yet
METHOD_LEARNINGS.md
PLAN.md
