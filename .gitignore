__pycache__/
*.py[cod]

# local Claude Code permissions (personal, not shared)
.claude/settings.local.json
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.venv/
venv/
.env

# Trained adapters — hundreds of MB each, and GitHub rejects files over 100MB.
ckpts/

# results/ DATA stays tracked: generations happen on a GPU pod that gets terminated, so
# tracking them is how they survive, and it lets `--resume` on a fresh pod skip whatever is
# already committed instead of regenerating it. Reviewers can also check the numbers against
# the rows they came from.
#
# The internal REPORTs do NOT stay tracked. They are working lab notes — retractions,
# debugging, protocol corrections, half-finished arms — written for us, not for readers.
# The paper carries the claims; RUNBOOK.md carries the reproduction steps.
results/*/REPORT.md

# Arms that were run and are NOT reported in the paper. Kept locally, out of the repo, so a
# reader cannot mistake a superseded or abandoned run for a result.
results/_unreported/
data/_unreported/
data/preference_probe/

# scripts kept for provenance but backing no reported claim
scripts/_archive/

# Intermediates on the way to prompts_final.jsonl, which is the only prompt file the
# pipeline reads. --expand writes prompts.jsonl, --topup writes prompts_balanced.jsonl,
# and check_contamination.py turns those into prompts_final.jsonl + prompts_rejected.jsonl.
data/sft/*/prompts.jsonl
data/sft/*/prompts_balanced.jsonl
data/sft/*/prompts_rejected.jsonl
data/sft/*/rewrites.jsonl
# eval-prompt scratch — the merged versions live in configs/evals/
data/sft/*/new_eval_prompts*.jsonl
# NOTE: scripts/build_sft_data.py stays tracked even though --expand is also laptop-only.
# Its --generate stage runs on the GPU pod, and the pod gets its code by cloning this
# repo — ignoring it would strand teacher generation.

.DS_Store

# working notes — methodology learnings draft, not for the repo yet
METHOD_LEARNINGS.md
PLAN.md
